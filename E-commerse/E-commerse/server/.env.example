# Copy this file to .env (never upload .env to GitHub)

# --- Required in production ---
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Your site's own URL (used to build links in emails). No trailing slash.
SITE_URL=https://lester1301.github.io/E-commerse

# --- Recommended ---
# Only allow your website to call the API (comma separated)
ALLOWED_ORIGINS=https://lester1301.github.io

# --- Database (MongoDB Atlas) ---
# Required in production. Data and uploaded photos are stored here, so nothing
# is lost when Render's free plan restarts. Leave empty only for local testing
# (then a JSON file in ./data is used).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=shopease

# --- AI assistant (optional) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# --- Email (optional but recommended) ---
# Order confirmations, password resets, and seller-approval emails.
# Pick ONE provider. Both have free tiers. You must verify your sending
# domain with the provider before real emails will deliver.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=re_xxx
# EMAIL_FROM="ShopEase <orders@yourdomain.com>"

# --- Payments: eSewa (optional) ---
# Works out of the box with public TEST credentials (the defaults already
# in the code) so you can try the whole flow before going live.
# Get your real merchant code and secret key from your eSewa merchant dashboard.
# ESEWA_MERCHANT_CODE=EPAYTEST
# ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# ESEWA_GATEWAY_URL=https://epay.esewa.com.np/api/epay/main/v2/form

# --- Payments: Khalti (optional) ---
# Works out of the box with a public TEST secret key.
# Get your real secret key from your Khalti merchant dashboard.
# KHALTI_SECRET_KEY=test_secret_key_dc74e0fd57cb46cd93832aee0a390234
# KHALTI_API_BASE=https://khalti.com/api/v2

# --- Image hosting (optional) ---
# Optional. Photos are already kept in MongoDB; use Cloudinary only if you
# want them served from a CDN.
# Create a free Cloudinary account and an UNSIGNED upload preset.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
